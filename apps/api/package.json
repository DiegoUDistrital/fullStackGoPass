{
  "name": "api",
  "version": "0.1.0",
  "description": "Backend API for project and task management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/**/*.test.js tests/**/*.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:admin": "tsx scripts/seed-admin.ts",
    "db:setup": "npm run db:migrate && npm run db:seed:admin"
  },
  "keywords": [
    "express",
    "typescript",
    "sequelize"
  ],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "sequelize": "^6.37.8"
  }
}
